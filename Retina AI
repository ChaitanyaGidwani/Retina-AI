{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"competition","sourceId":145323}],"dockerImageVersionId":31400,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# ============================================================\n# RETINA AI — Student Dropout Risk Prediction\n# Multimodal Stacking Ensemble\n# Macro F1 CV: ~0.70+\n# ============================================================\n\nimport pandas as pd\nimport numpy as np\nfrom sklearn.preprocessing import LabelEncoder\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.metrics import f1_score, classification_report\nfrom sklearn.ensemble import HistGradientBoostingClassifier\nimport lightgbm as lgb\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# ============================================================\n# STEP 1 — LOAD DATA\n# ============================================================\ntrain      = pd.read_csv('/kaggle/input/competitions/retina-ai-predict-student-dropout-risk-with-deep-learning/train.csv')\ntest       = pd.read_csv('/kaggle/input/competitions/retina-ai-predict-student-dropout-risk-with-deep-learning/test.csv')\nattendance = pd.read_csv('/kaggle/input/competitions/retina-ai-predict-student-dropout-risk-with-deep-learning/Attendance_series.csv')\nnotes      = pd.read_csv('/kaggle/input/competitions/retina-ai-predict-student-dropout-risk-with-deep-learning/Counsellor_notes.csv')\n\nprint(f\"Train: {train.shape} | Test: {test.shape}\")\nprint(f\"Attendance: {attendance.shape} | Notes: {notes.shape}\")\nprint(f\"Target distribution:\\n{train['dropout_risk'].value_counts().sort_index()}\")\n\n# ============================================================\n# STEP 2 — ATTENDANCE FEATURE ENGINEERING (Time-Series)\n# ============================================================\nprint(\"\\n[1/5] Engineering attendance features...\")\n\n# Overall stats per student\natt_overall = attendance.groupby('student_id')['attendance_pct'].agg(\n    att_mean   = 'mean',\n    att_min    = 'min',\n    att_max    = 'max',\n    att_std    = 'std',\n    att_median = 'median'\n).reset_index()\n\n# Per-semester mean attendance\natt_sem = attendance.groupby(['student_id','semester'])['attendance_pct'].mean().unstack()\natt_sem.columns = [f'att_sem{c}_mean' for c in att_sem.columns]\natt_sem = att_sem.reset_index()\n\n# Per-subject mean attendance\natt_subj = attendance.groupby(['student_id','subject'])['attendance_pct'].mean().unstack()\natt_subj.columns = [f'att_{str(c).lower()}_mean' for c in att_subj.columns]\natt_subj = att_subj.reset_index()\n\n# Fraction of poor attendance weeks (< 75%)\nattendance['low_att'] = (attendance['attendance_pct'] < 0.75).astype(int)\natt_poor = attendance.groupby('student_id')['low_att'].mean().reset_index()\natt_poor.columns = ['student_id', 'att_pct_poor_weeks']\n\n# Semester attendance decline (Sem1 mean - Sem3 mean)\natt_dec = attendance.groupby(['student_id','semester'])['attendance_pct'].mean().unstack()\natt_dec.columns = [f's{c}' for c in att_dec.columns]\natt_dec = att_dec.reset_index()\natt_dec['att_sem_decline'] = att_dec.get('s1', 0) - att_dec.get('s3', 0)\n\n# Merge all attendance features\natt_feats = (att_overall\n    .merge(att_sem,  on='student_id', how='left')\n    .merge(att_subj, on='student_id', how='left')\n    .merge(att_poor, on='student_id', how='left')\n    .merge(att_dec[['student_id','att_sem_decline']], on='student_id', how='left')\n)\nprint(f\"   Attendance features: {att_feats.shape[1]-1} columns\")\n\n# ============================================================\n# STEP 3 — NLP FEATURE ENGINEERING (Counsellor Notes)\n# ============================================================\nprint(\"[2/5] Engineering NLP features...\")\n\nnotes['counsellor_note'] = notes['counsellor_note'].fillna('no note')\n\n# KEY INSIGHT: Only 54 unique notes exist. Target-encode each note\n# with its mean dropout_risk from training data — most powerful NLP feature\nnote_risk_map = (\n    train.merge(notes, on='student_id', how='left')\n    .groupby('counsellor_note')['dropout_risk'].mean()\n    .to_dict()\n)\nnotes['note_risk_score'] = notes['counsellor_note'].map(note_risk_map)\n\n# TF-IDF for additional text signal (100 features, unigrams + bigrams)\ntfidf = TfidfVectorizer(max_features=100, ngram_range=(1,2), stop_words='english')\ntfidf.fit(notes['counsellor_note'])\ntfidf_arr = tfidf.transform(notes['counsellor_note']).toarray()\ntfidf_df  = pd.DataFrame(tfidf_arr, columns=[f'tf_{i}' for i in range(100)])\ntfidf_df['student_id'] = notes['student_id'].values\n\nnote_feats = notes[['student_id','note_risk_score']].merge(tfidf_df, on='student_id', how='left')\nprint(f\"   Note features: {note_feats.shape[1]-1} columns\")\n\n# ============================================================\n# STEP 4 — TABULAR FEATURE ENGINEERING\n# ============================================================\nprint(\"[3/5] Engineering tabular features...\")\n\ndef engineer_features(df):\n    df = df.copy()\n\n    # CGPA trends across semesters\n    cgpa_cols = ['cgpa_sem1','cgpa_sem2','cgpa_sem3','cgpa_sem4']\n    df['cgpa_mean']       = df[cgpa_cols].mean(axis=1)\n    df['cgpa_min']        = df[cgpa_cols].min(axis=1)\n    df['cgpa_std']        = df[cgpa_cols].std(axis=1)\n    df['cgpa_slope']      = df['cgpa_sem4'] - df['cgpa_sem1']   # overall direction\n    df['cgpa_late_drop']  = df['cgpa_sem3'] - df['cgpa_sem4']   # recent decline\n    df['cgpa_sem12_avg']  = (df['cgpa_sem1'] + df['cgpa_sem2']) / 2\n    df['cgpa_sem34_avg']  = (df['cgpa_sem3'] + df['cgpa_sem4']) / 2\n    df['cgpa_2h_vs_1h']   = df['cgpa_sem34_avg'] - df['cgpa_sem12_avg']  # 2nd half trend\n    df['cgpa_decline']    = (df['cgpa_sem4'] < df['cgpa_sem1']).astype(int)\n\n    # Backlog features\n    bl_cols = ['backlogs_sem1','backlogs_sem2','backlogs_sem3']\n    df['total_backlogs']   = df[bl_cols].sum(axis=1)\n    df['backlog_increase'] = df['backlogs_sem3'] - df['backlogs_sem1']\n    df['has_backlogs']     = (df['total_backlogs'] > 0).astype(int)\n    df['severe_backlogs']  = (df['total_backlogs'] >= 3).astype(int)\n\n    # Interaction: low CGPA + high backlogs = strong risk signal\n    df['risk_combo'] = df['total_backlogs'] * (10 - df['cgpa_mean'])\n\n    return df\n\ntrain = engineer_features(train)\ntest  = engineer_features(test)\n\n# ============================================================\n# STEP 5 — MERGE ALL MODALITIES\n# ============================================================\nprint(\"[4/5] Merging all data modalities...\")\n\ndef merge_all(df):\n    return (df\n        .merge(att_feats,  on='student_id', how='left')\n        .merge(note_feats, on='student_id', how='left')\n    )\n\ntrain_full = merge_all(train)\ntest_full  = merge_all(test)\n\n# Encode categoricals\ncat_cols = ['branch','gender','hostel_status','family_income','parent_education']\nfor col in cat_cols:\n    le = LabelEncoder()\n    combined = pd.concat([train_full[col], test_full[col]]).fillna('Unknown').astype(str)\n    le.fit(combined)\n    train_full[col] = le.transform(train_full[col].fillna('Unknown').astype(str))\n    test_full[col]  = le.transform(test_full[col].fillna('Unknown').astype(str))\n\n# Prepare feature matrices\ny            = train_full['dropout_risk'].values\nfeature_cols = [c for c in train_full.columns if c not in ['student_id','dropout_risk']]\nX_train      = train_full[feature_cols].copy()\nX_test       = test_full[feature_cols].copy()\n\n# Impute remaining missing values\nimp     = SimpleImputer(strategy='median')\nX_train = pd.DataFrame(imp.fit_transform(X_train), columns=feature_cols)\nX_test  = pd.DataFrame(imp.transform(X_test),      columns=feature_cols)\n\nprint(f\"   Final feature matrix: {X_train.shape}\")\nprint(f\"   Class distribution: {np.bincount(y)} (Low / Medium / High)\")\n\n# ============================================================\n# STEP 6 — TRAIN STACKING ENSEMBLE\n# ============================================================\nprint(\"\\n[5/5] Training stacking ensemble...\")\n\nskf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n\n# --- Base Model 1: HistGradientBoosting ---\nhgb = HistGradientBoostingClassifier(\n    max_iter=300, learning_rate=0.05,\n    class_weight='balanced', random_state=42\n)\nhgb_oof  = np.zeros((len(y), 3))\nhgb_test = np.zeros((len(X_test), 3))\n\nfor fold, (tr, val) in enumerate(skf.split(X_train, y)):\n    hgb.fit(X_train.iloc[tr], y[tr])\n    hgb_oof[val]  = hgb.predict_proba(X_train.iloc[val])\n    hgb_test     += hgb.predict_proba(X_test) / 5\n\nhgb_f1 = f1_score(y, hgb_oof.argmax(1), average='macro')\nprint(f\"   HistGBM   OOF F1: {hgb_f1:.4f}\")\n\n# --- Base Model 2: LightGBM ---\nlgb_m = lgb.LGBMClassifier(\n    n_estimators=300, num_leaves=31, learning_rate=0.08,\n    subsample=0.8, colsample_bytree=0.8,\n    class_weight='balanced', random_state=42, n_jobs=-1, verbose=-1\n)\nlgb_oof  = np.zeros((len(y), 3))\nlgb_test = np.zeros((len(X_test), 3))\n\nfor fold, (tr, val) in enumerate(skf.split(X_train, y)):\n    lgb_m.fit(X_train.iloc[tr], y[tr])\n    lgb_oof[val]  = lgb_m.predict_proba(X_train.iloc[val])\n    lgb_test     += lgb_m.predict_proba(X_test) / 5\n\nlgb_f1 = f1_score(y, lgb_oof.argmax(1), average='macro')\nprint(f\"   LightGBM  OOF F1: {lgb_f1:.4f}\")\n\n# --- Meta-Learner: Logistic Regression on stacked OOF probs ---\nmeta_X_train = np.hstack([hgb_oof, lgb_oof])   # shape: (12000, 6)\nmeta_X_test  = np.hstack([hgb_test, lgb_test])  # shape: (3000, 6)\n\nmeta = LogisticRegression(C=1.0, max_iter=1000, class_weight='balanced', random_state=42)\nstack_oof = np.zeros(len(y), dtype=int)\nfor tr, val in skf.split(meta_X_train, y):\n    meta.fit(meta_X_train[tr], y[tr])\n    stack_oof[val] = meta.predict(meta_X_train[val])\n\nstack_f1 = f1_score(y, stack_oof, average='macro')\nprint(f\"   STACK     OOF F1: {stack_f1:.4f}  ← final score\")\n\n# Detailed per-class breakdown\nprint(\"\\n--- Per-Class Performance ---\")\nprint(classification_report(y, stack_oof, target_names=['Low Risk','Medium Risk','High Risk']))\n\n# ============================================================\n# STEP 7 — GENERATE FINAL PREDICTIONS\n# ============================================================\nmeta.fit(meta_X_train, y)\nfinal_preds = meta.predict(meta_X_test)\n\nprint(f\"Prediction distribution: {np.bincount(final_preds)}\")\nprint(f\"  Low Risk (0): {np.sum(final_preds==0)}\")\nprint(f\"  Med Risk (1): {np.sum(final_preds==1)}\")\nprint(f\"  High Risk(2): {np.sum(final_preds==2)}\")\n\n# ============================================================\n# STEP 8 — SAVE SUBMISSION\n# ============================================================\nsubmission = pd.DataFrame({\n    'student_id':   test_full['student_id'],\n    'dropout_risk': final_preds\n})\nsubmission.to_csv('model_submission.csv', index=False)\n\nprint(\"\\n✅ model_submission.csv saved!\")\nprint(submission.head(10).to_string())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-12T10:16:09.772382Z","iopub.execute_input":"2026-06-12T10:16:09.772774Z","iopub.status.idle":"2026-06-12T10:17:36.3645Z","shell.execute_reply.started":"2026-06-12T10:16:09.772743Z","shell.execute_reply":"2026-06-12T10:17:36.363621Z"}},"outputs":[{"name":"stdout","text":"Train: (12000, 18) | Test: (3000, 17)\nAttendance: (1048575, 5) | Notes: (15000, 2)\nTarget distribution:\ndropout_risk\n0    7200\n1    3000\n2    1800\nName: count, dtype: int64\n\n[1/5] Engineering attendance features...\n   Attendance features: 13 columns\n[2/5] Engineering NLP features...\n   Note features: 101 columns\n[3/5] Engineering tabular features...\n[4/5] Merging all data modalities...\n   Final feature matrix: (12000, 144)\n   Class distribution: [7200 3000 1800] (Low / Medium / High)\n\n[5/5] Training stacking ensemble...\n   HistGBM   OOF F1: 0.6964\n   LightGBM  OOF F1: 0.7031\n   STACK     OOF F1: 0.7036  ← final score\n\n--- Per-Class Performance ---\n              precision    recall  f1-score   support\n\n    Low Risk       0.89      0.84      0.86      7200\n Medium Risk       0.51      0.52      0.52      3000\n   High Risk       0.67      0.81      0.73      1800\n\n    accuracy                           0.75     12000\n   macro avg       0.69      0.72      0.70     12000\nweighted avg       0.76      0.75      0.76     12000\n\nPrediction distribution: [1688  758  554]\n  Low Risk (0): 1688\n  Med Risk (1): 758\n  High Risk(2): 554\n\n✅ model_submission.csv saved!\n  student_id  dropout_risk\n0   STU03679             0\n1   STU11070             0\n2   STU13561             2\n3   STU00061             1\n4   STU02416             2\n5   STU14493             0\n6   STU14070             2\n7   STU12038             0\n8   STU13254             0\n9   STU12397             0\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"import matplotlib.pyplot as plt\nfrom sklearn.metrics import ConfusionMatrixDisplay, confusion_matrix\n\ncm = confusion_matrix(y, stack_oof)\ndisp = ConfusionMatrixDisplay(cm, display_labels=['Low Risk','Medium Risk','High Risk'])\ndisp.plot(cmap='Blues')\nplt.title('Confusion Matrix — Stacking Ensemble')\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-12T10:23:04.631611Z","iopub.execute_input":"2026-06-12T10:23:04.632062Z","iopub.status.idle":"2026-06-12T10:23:04.897252Z","shell.exec