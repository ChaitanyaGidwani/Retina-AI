    "# ============================================================\n",
    "# RETINA AI — Student Dropout Risk Prediction\n",
    "# Multimodal Stacking Ensemble\n",
    "# Macro F1 CV: ~0.70+\n",
    "# ============================================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "from sklearn.metrics import f1_score, classification_report\n",
    "from sklearn.ensemble import HistGradientBoostingClassifier\n",
    "import lightgbm as lgb\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# ============================================================\n",
    "# STEP 1 — LOAD DATA\n",
    "# ============================================================\n",
    "train      = pd.read_csv('/kaggle/input/competitions/retina-ai-predict-student-dropout-risk-with-deep-learning/train.csv')\n",
    "test       = pd.read_csv('/kaggle/input/competitions/retina-ai-predict-student-dropout-risk-with-deep-learning/test.csv')\n",
    "attendance = pd.read_csv('/kaggle/input/competitions/retina-ai-predict-student-dropout-risk-with-deep-learning/Attendance_series.csv')\n",
    "notes      = pd.read_csv('/kaggle/input/competitions/retina-ai-predict-student-dropout-risk-with-deep-learning/Counsellor_notes.csv')\n",
    "\n",
    "print(f\"Train: {train.shape} | Test: {test.shape}\")\n",
    "print(f\"Attendance: {attendance.shape} | Notes: {notes.shape}\")\n",
    "print(f\"Target distribution:\\n{train['dropout_risk'].value_counts().sort_index()}\")\n",
    "\n",
    "# ============================================================\n",
    "# STEP 2 — ATTENDANCE FEATURE ENGINEERING (Time-Series)\n",
    "# ============================================================\n",
    "print(\"\\n[1/5] Engineering attendance features...\")\n",
    "\n",
    "# Overall stats per student\n",
    "att_overall = attendance.groupby('student_id')['attendance_pct'].agg(\n",
    "    att_mean   = 'mean',\n",
    "    att_min    = 'min',\n",
    "    att_max    = 'max',\n",
    "    att_std    = 'std',\n",
    "    att_median = 'median'\n",
    ").reset_index()\n",
    "\n",
    "# Per-semester mean attendance\n",
    "att_sem = attendance.groupby(['student_id','semester'])['attendance_pct'].mean().unstack()\n",
    "att_sem.columns = [f'att_sem{c}_mean' for c in att_sem.columns]\n",
    "att_sem = att_sem.reset_index()\n",
    "\n",
    "# Per-subject mean attendance\n",
    "att_subj = attendance.groupby(['student_id','subject'])['attendance_pct'].mean().unstack()\n",
    "att_subj.columns = [f'att_{str(c).lower()}_mean' for c in att_subj.columns]\n",
    "att_subj = att_subj.reset_index()\n",
    "\n",
    "# Fraction of poor attendance weeks (< 75%)\n",
    "attendance['low_att'] = (attendance['attendance_pct'] < 0.75).astype(int)\n",
    "att_poor = attendance.groupby('student_id')['low_att'].mean().reset_index()\n",
    "att_poor.columns = ['student_id', 'att_pct_poor_weeks']\n",
    "\n",
    "# Semester attendance decline (Sem1 mean - Sem3 mean)\n",
    "att_dec = attendance.groupby(['student_id','semester'])['attendance_pct'].mean().unstack()\n",
    "att_dec.columns = [f's{c}' for c in att_dec.columns]\n",
    "att_dec = att_dec.reset_index()\n",
    "att_dec['att_sem_decline'] = att_dec.get('s1', 0) - att_dec.get('s3', 0)\n",
    "\n",
    "# Merge all attendance features\n",
    "att_feats = (att_overall\n",
    "    .merge(att_sem,  on='student_id', how='left')\n",
    "    .merge(att_subj, on='student_id', how='left')\n",
    "    .merge(att_poor, on='student_id', how='left')\n",
    "    .merge(att_dec[['student_id','att_sem_decline']], on='student_id', how='left')\n",
    ")\n",
    "print(f\"   Attendance features: {att_feats.shape[1]-1} columns\")\n",
    "\n",
    "# ============================================================\n",
    "# STEP 3 — NLP FEATURE ENGINEERING (Counsellor Notes)\n",
    "# ============================================================\n",
    "print(\"[2/5] Engineering NLP features...\")\n",
    "\n",
    "notes['counsellor_note'] = notes['counsellor_note'].fillna('no note')\n",
    "\n",
    "# KEY INSIGHT: Only 54 unique notes exist. Target-encode each note\n",
    "# with its mean dropout_risk from training data — most powerful NLP feature\n",
    "note_risk_map = (\n",
    "    train.merge(notes, on='student_id', how='left')\n",
    "    .groupby('counsellor_note')['dropout_risk'].mean()\n",
    "    .to_dict()\n",
    ")\n",
    "notes['note_risk_score'] = notes['counsellor_note'].map(note_risk_map)\n",
    "\n",
    "# TF-IDF for additional text signal (100 features, unigrams + bigrams)\n",
    "tfidf = TfidfVectorizer(max_features=100, ngram_range=(1,2), stop_words='english')\n",
    "tfidf.fit(notes['counsellor_note'])\n",
    "tfidf_arr = tfidf.transform(notes['counsellor_note']).toarray()\n",
    "tfidf_df  = pd.DataFrame(tfidf_arr, columns=[f'tf_{i}' for i in range(100)])\n",
    "tfidf_df['student_id'] = notes['student_id'].values\n",
    "\n",
    "note_feats = notes[['student_id','note_risk_score']].merge(tfidf_df, on='student_id', how='left')\n",
    "print(f\"   Note features: {note_feats.shape[1]-1} columns\")\n",
    "\n",
    "# ============================================================\n",
    "# STEP 4 — TABULAR FEATURE ENGINEERING\n",
    "# ============================================================\n",
    "print(\"[3/5] Engineering tabular features...\")\n",
    "\n",
    "def engineer_features(df):\n",
    "    df = df.copy()\n",
    "\n",
    "    # CGPA trends across semesters\n",
    "    cgpa_cols = ['cgpa_sem1','cgpa_sem2','cgpa_sem3','cgpa_sem4']\n",
    "    df['cgpa_mean']       = df[cgpa_cols].mean(axis=1)\n",
    "    df['cgpa_min']        = df[cgpa_cols].min(axis=1)\n",
    "    df['cgpa_std']        = df[cgpa_cols].std(axis=1)\n",
    "    df['cgpa_slope']      = df['cgpa_sem4'] - df['cgpa_sem1']   # overall direction\n",
    "    df['cgpa_late_drop']  = df['cgpa_sem3'] - df['cgpa_sem4']   # recent decline\n",
    "    df['cgpa_sem12_avg']  = (df['cgpa_sem1'] + df['cgpa_sem2']) / 2\n",
    "    df['cgpa_sem34_avg']  = (df['cgpa_sem3'] + df['cgpa_sem4']) / 2\n",
    "    df['cgpa_2h_vs_1h']   = df['cgpa_sem34_avg'] - df['cgpa_sem12_avg']  # 2nd half trend\n",
    "    df['cgpa_decline']    = (df['cgpa_sem4'] < df['cgpa_sem1']).astype(int)\n",
    "\n",
    "    # Backlog features\n",
    "    bl_cols = ['backlogs_sem1','backlogs_sem2','backlogs_sem3']\n",
    "    df['total_backlogs']   = df[bl_cols].sum(axis=1)\n",
    "    df['backlog_increase'] = df['backlogs_sem3'] - df['backlogs_sem1']\n",
    "    df['has_backlogs']     = (df['total_backlogs'] > 0).astype(int)\n",
    "    df['severe_backlogs']  = (df['total_backlogs'] >= 3).astype(int)\n",
    "\n",
    "    # Interaction: low CGPA + high backlogs = strong risk signal\n",
    "    df['risk_combo'] = df['total_backlogs'] * (10 - df['cgpa_mean'])\n",
    "\n",
    "    return df\n",
    "\n",
    "train = engineer_features(train)\n",
    "test  = engineer_features(test)\n",
    "\n",
    "# ============================================================\n",
    "# STEP 5 — MERGE ALL MODALITIES\n",
    "# ============================================================\n",
    "print(\"[4/5] Merging all data modalities...\")\n",
    "\n",
    "def merge_all(df):\n",
    "    return (df\n",
    "        .merge(att_feats,  on='student_id', how='left')\n",
    "        .merge(note_feats, on='student_id', how='left')\n",
    "    )\n",
    "\n",
    "train_full = merge_all(train)\n",
    "test_full  = merge_all(test)\n",
    "\n",
    "# Encode categoricals\n",
    "cat_cols = ['branch','gender','hostel_status','family_income','parent_education']\n",
    "for col in cat_cols:\n",
    "    le = LabelEncoder()\n",
    "    combined = pd.concat([train_full[col], test_full[col]]).fillna('Unknown').astype(str)\n",
    "    le.fit(combined)\n",
    "    train_full[col] = le.transform(train_full[col].fillna('Unknown').astype(str))\n",
    "    test_full[col]  = le.transform(test_full[col].fillna('Unknown').astype(str))\n",
    "\n",
    "# Prepare feature matrices\n",
    "y            = train_full['dropout_risk'].values\n",
    "feature_cols = [c for c in train_full.columns if c not in ['student_id','dropout_risk']]\n",
    "X_train      = train_full[feature_cols].copy()\n",
    "X_test       = test_full[feature_cols].copy()\n",
    "\n",
    "# Impute remaining missing values\n",
    "imp     = SimpleImputer(strategy='median')\n",
    "X_train = pd.DataFrame(imp.fit_transform(X_train), columns=feature_cols)\n",
    "X_test  = pd.DataFrame(imp.transform(X_test),      columns=feature_cols)\n",
    "\n",
    "print(f\"   Final feature matrix: {X_train.shape}\")\n",
    "print(f\"   Class distribution: {np.bincount(y)} (Low / Medium / High)\")\n",
    "\n",
    "# ============================================================\n",
    "# STEP 6 — TRAIN STACKING ENSEMBLE\n",
    "# ============================================================\n",
    "print(\"\\n[5/5] Training stacking ensemble...\")\n",
    "\n",
    "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "# --- Base Model 1: HistGradientBoosting ---\n",
    "hgb = HistGradientBoostingClassifier(\n",
    "    max_iter=300, learning_rate=0.05,\n",
    "    class_weight='balanced', random_state=42\n",
    ")\n",
    "hgb_oof  = np.zeros((len(y), 3))\n",
    "hgb_test = np.zeros((len(X_test), 3))\n",
    "\n",
    "for fold, (tr, val) in enumerate(skf.split(X_train, y)):\n",
    "    hgb.fit(X_train.iloc[tr], y[tr])\n",
    "    hgb_oof[val]  = hgb.predict_proba(X_train.iloc[val])\n",
    "    hgb_test     += hgb.predict_proba(X_test) / 5\n",
    "\n",
    "hgb_f1 = f1_score(y, hgb_oof.argmax(1), average='macro')\n",
    "print(f\"   HistGBM   OOF F1: {hgb_f1:.4f}\")\n",
    "\n",
    "# --- Base Model 2: LightGBM ---\n",
    "lgb_m = lgb.LGBMClassifier(\n",
    "    n_estimators=300, num_leaves=31, learning_rate=0.08,\n",
    "    subsample=0.8, colsample_bytree=0.8,\n",
    "    class_weight='balanced', random_state=42, n_jobs=-1, verbose=-1\n",
    ")\n",
    "lgb_oof  = np.zeros((len(y), 3))\n",
    "lgb_test = np.zeros((len(X_test), 3))\n",
    "\n",
    "for fold, (tr, val) in enumerate(skf.split(X_train, y)):\n",
    "    lgb_m.fit(X_train.iloc[tr], y[tr])\n",
    "    lgb_oof[val]  = lgb_m.predict_proba(X_train.iloc[val])\n",
    "    lgb_test     += lgb_m.predict_proba(X_test) / 5\n",
    "\n",
    "lgb_f1 = f1_score(y, lgb_oof.argmax(1), average='macro')\n",
    "print(f\"   LightGBM  OOF F1: {lgb_f1:.4f}\")\n",
    "\n",
    "# --- Meta-Learner: Logistic Regression on stacked OOF probs ---\n",
    "meta_X_train = np.hstack([hgb_oof, lgb_oof])   # shape: (12000, 6)\n",
    "meta_X_test  = np.hstack([hgb_test, lgb_test])  # shape: (3000, 6)\n",
    "\n",
    "meta = LogisticRegression(C=1.0, max_iter=1000, class_weight='balanced', random_state=42)\n",
    "stack_oof = np.zeros(len(y), dtype=int)\n",
    "for tr, val in skf.split(meta_X_train, y):\n",
    "    meta.fit(meta_X_train[tr], y[tr])\n",
    "    stack_oof[val] = meta.predict(meta_X_train[val])\n",
    "\n",
    "stack_f1 = f1_score(y, stack_oof, average='macro')\n",
    "print(f\"   STACK     OOF F1: {stack_f1:.4f}  ← final score\")\n",
    "\n",
    "# Detailed per-class breakdown\n",
    "print(\"\\n--- Per-Class Performance ---\")\n",
    "print(classification_report(y, stack_oof, target_names=['Low Risk','Medium Risk','High Risk']))\n",
    "\n",
    "# ============================================================\n",
    "# STEP 7 — GENERATE FINAL PREDICTIONS\n",
    "# ============================================================\n",
    "meta.fit(meta_X_train, y)\n",
    "final_preds = meta.predict(meta_X_test)\n",
    "\n",
    "print(f\"Prediction distribution: {np.bincount(final_preds)}\")\n",
    "print(f\"  Low Risk (0): {np.sum(final_preds==0)}\")\n",
    "print(f\"  Med Risk (1): {np.sum(final_preds==1)}\")\n",
    "print(f\"  High Risk(2): {np.sum(final_preds==2)}\")\n",
    "\n",
    "# ============================================================\n",
    "# STEP 8 — SAVE SUBMISSION\n",
    "# ============================================================\n",
    "submission = pd.DataFrame({\n",
    "    'student_id':   test_full['student_id'],\n",
    "    'dropout_risk': final_preds\n",
    "})\n",
    "submission.to_csv('model_submission.csv', index=False)\n",
    "\n",
    "print(\"\\n✅ model_submission.csv saved!\")\n",
    "print(submission.head(10).to_string())"
   ]
